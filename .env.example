# Copiar a .env y reemplazar ambas contraseñas antes de iniciar.
DB_NAME=monitor
DB_USER=monitor
DB_PASSWORD=cambiar_clave_monitor
DB_ROOT_PASSWORD=cambiar_clave_root

# Web local. Para acceder desde otra PC del laboratorio: WEB_BIND_IP=0.0.0.0
WEB_BIND_IP=127.0.0.1
WEB_PORT=8000

# Pausa entre rondas de consultas y días de historial conservados.
POLL_INTERVAL=30
RETENTION_DAYS=7
